# ------------------------------------------------------------------------------
# Backend Service Environment Variables
# ------------------------------------------------------------------------------
PORT=8080
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=*

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=suporter
DB_SSLMODE=disable

# Security & Tokens
JWT_SECRET=
JWT_EXPIRY_HOURS=24
RECAPTCHA_SECRET_KEY=
ENABLE_WEBHOOK_HMAC=true
