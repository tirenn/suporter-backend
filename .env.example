PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=suporter
DB_SSLMODE=disable

# Security & JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY_HOURS=24

# Public Server URL (used to generate OBS Browser Source overlay URLs)
APP_URL=http://localhost:8080

# CORS Allowed Origins (comma-separated domains, or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
